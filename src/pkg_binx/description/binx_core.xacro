<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >


    <!-- colors -->
    <material name="white">
        <color rgba="1 1 1 1" />
    </material>

    <material name="blue"> 
        <color rgba="0.150 0.178 0.242 1"/>
    </material>

    <material name="pink">
        <color rgba="0.237 0.199 0.220 1"/>
    </material>

    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

    <material name = "gray">
        <color rgba = "0.05 0.05 0.05 1"/>
    </material>


    <!-- ######################## -->
    <!-- Defining robot constants -->
    <!-- ######################## -->

    <xacro:property name = "pi_const" value = "3.14159265" />

    <!-- modifier -->
    <xacro:property name = "m" value = "1" />

    <!-- chassis dimensions -->
    <xacro:property name = "l" value = "${m*1}" />
    <xacro:property name = "h" value = "${m*0.3}" />
    <xacro:property name = "w" value = "${m*0.75}" />

    <!-- wheel radius and diameter -->
    <xacro:property name = "r" value = "${m*0.15}" />
    <xacro:property name = "d" value = "${m*0.1}" />

    <!-- other dimensions (look at aleks's vid for the full picture)-->
    <xacro:property name = "s1" value = "${h/2 + r}" />
    <xacro:property name = "s2" value = "${2*r}" />
    <xacro:property name = "s3" value = "${2*r}" />
    <xacro:property name = "s4" value = "${w/2 + d/2}" />


    <!-- ##################################### -->
    <!-- Defining mass and inertial properites -->
    <!-- ##################################### -->


    <!-- material densities -->
    <xacro:property name = "bodyDensity" value = "2710.0" />
    <xacro:property name = "wheelDensity" value = "2710.0" />

    <!-- mass -->
    <xacro:property name = "bodyMass" value = "${bodyDensity*l*h*w}" />
    <xacro:property name = "wheelMass" value = "${wheelDensity*pi_const*r*r*d}" />


    <!-- moments of inertia -->

    <xacro:property name = "Ix_body" value = "${(1/12)*bodyMass*(h*h + w*w)}" />
    <xacro:property name = "Iy_body" value = "${(1/12)*bodyMass*(l*l + h*h)}" />
    <xacro:property name = "Iz_body" value = "${(1/12)*bodyMass*(l*l + w*w)}" />

    <xacro:property name = "Iz_wheel" value = "${0.5*wheelMass*r*r}" />
    <xacro:property name = "I_wheel" value = "${(1.0/12.0)*wheelMass*(3.0*r*r + d*d)}" />


    <!-- inertial macros -->

    <xacro:macro name = "inertia_body">
        <inertial>
            <origin rpy = "0 0 0" xyz = "0 0 ${s1}" />
            <mass value = "${bodyMass}" />
            <inertia ixx = "${Ix_body}" ixy = "0.0" ixz = "0.0" iyy = "${Iy_body}" iyz = "0" izz = "${Iz_body}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name = "inertia_wheel">
        <inertial>
            <origin rpy = "1.570795 0 0" xyz = "0 0 0" />
            <mass value = "${wheelMass}" />
            <inertia ixx = "${I_wheel}" ixy = "0.0" ixz = "0.0" iyy = "${I_wheel}" iyz = "0" izz = "${Iz_wheel}" />
        </inertial>
    </xacro:macro>



    <!-- ########################## -->
    <!-- Including additional files -->
    <!-- ########################## -->

    <xacro:include filename = "$(find pkg_binx)/description/robot.gazebo" />


    <!-- ####################### -->
    <!-- Defining links & joints -->
    <!-- ####################### -->

    <!-- fictitious link -->
    <link name = "base_footprint"> 
    </link>
    <joint name = "base_link_joint" type = "fixed">
        <parent link = "base_footprint" />
        <child link = "base_link" />
    </joint>

    <!-- body link -->
    <!-- *figure out if you need to change the origin's x value to -0.1 or sum* -->
    <link name = "base_link">
        <visual>
            <origin rpy = "0 0 0" xyz = "0 0 ${s1}" />
            <geometry>
                <box size = "${l} ${w} ${h}" />
            </geometry>
            <material name = "blue" />
        </visual>

        <collision>
            <origin rpy = "0 0 0" xyz = "0 0 ${s1}" />
            <geometry>
                <box size = "${l} ${w} ${h}" />
            </geometry>
        </collision>

        <xacro:inertia_body />
    </link>


    <!-- right wheel rear link -->
    <!-- remember to make the limit effort more realistic later... -->
    <joint name= "wheel1_joint" type = "continuous">
        <parent link = "base_link" />
        <child link = "wheel1_link" />
        <origin xyz = "${-s2} ${-s4} ${r}" rpy = "0 0 0" />
        <axis xyz = "0 1 0" />
        <limit effort = "50000" velocity = "10" />
        <dynamics damping = "0.05" friction = "0.0" />
    </joint>

    <link name = "wheel1_link">
        <visual>
            <origin rpy = "1.570795 0 0" xyz = "0 0 0" />
            <geometry>
                <cylinder length = "${d}" radius = "${r}" />
            </geometry>
            <material name = "pink" />
        </visual>

        <collision name = "wheel1_collision">
            <origin rpy = "1.57095 0 0" xyz = "0 0 0" />
            <geometry>
                <cylinder length = "${d}" radius = "${r}" />
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>2.0</mu>
                        <mu2>0.5</mu2>
                        <fdir1>-1 -1 0</fdir1>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>1000000.0</kp>
                        <kd>100.0</kd>
                        <min_depth>0.001</min_depth>
                        <max_vel>0.1</max_vel>
                    </ode>
                </contact>
            </surface>
        </collision>

        <xacro:inertia_wheel />
    </link>


    <!-- left wheel rear link -->
    <!-- remember to make the limit effort more realistic later... -->
    <joint name= "wheel2_joint" type = "continuous">
        <parent link = "base_link" />
        <child link = "wheel2_link" />
        <origin xyz = "${-s2} ${s4} ${r}" rpy = "0 0 0" />
        <axis xyz = "0 1 0" />
        <limit effort = "50000" velocity = "10" />
        <dynamics damping = "0.05" friction = "0.0" />
    </joint>

    <link name = "wheel2_link">
        <visual>
            <origin rpy = "1.570795 0 0" xyz = "0 0 0" />
            <geometry>
                <cylinder length = "${d}" radius = "${r}" />
            </geometry>
            <material name = "pink" />
        </visual>

        <collision name = "wheel2_collision">
            <origin rpy = "1.57095 0 0" xyz = "0 0 0" />
            <geometry>
                <cylinder length = "${d}" radius = "${r}" />
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>2.0</mu>
                        <mu2>0.5</mu2>
                        <fdir1>-1 1 0</fdir1>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>1000000.0</kp>
                        <kd>100.0</kd>
                        <min_depth>0.001</min_depth>
                        <max_vel>0.1</max_vel>
                    </ode>
                </contact>
            </surface>
        </collision>

        <xacro:inertia_wheel />
    </link>


    <!-- right wheel forward link -->
    <joint name= "wheel3_joint" type = "continuous">
        <parent link = "base_link" />
        <child link = "wheel3_link" />
        <origin xyz = "${s2} ${-s4} ${r}" rpy = "0 0 0" />
        <axis xyz = "0 1 0" />
        <limit effort = "50000" velocity = "10" />
        <dynamics damping = "0.05" friction = "0.0" />
    </joint>

    <link name = "wheel3_link">
        <visual>
            <origin rpy = "1.570795 0 0" xyz = "0 0 0" />
            <geometry>
                <cylinder length = "${d}" radius = "${r}" />
            </geometry>
            <material name = "pink" />
        </visual>

        <collision name = "wheel3_collision">
            <origin rpy = "1.57095 0 0" xyz = "0 0 0" />
            <geometry>
                <cylinder length = "${d}" radius = "${r}" />
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>2.0</mu>
                        <mu2>0.5</mu2>
                        <fdir1>1 -1 0</fdir1>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>1000000.0</kp>
                        <kd>100.0</kd>
                        <min_depth>0.001</min_depth>
                        <max_vel>0.1</max_vel>
                    </ode>
                </contact>
            </surface>
        </collision>

        <xacro:inertia_wheel />
    </link>


    <!-- left wheel forward link -->
    <joint name= "wheel4_joint" type = "continuous">
        <parent link = "base_link" />
        <child link = "wheel4_link" />
        <origin xyz = "${s2} ${s4} ${r}" rpy = "0 0 0" />
        <axis xyz = "0 1 0" />
        <limit effort = "50000" velocity = "10" />
        <dynamics damping = "0.05" friction = "0.0" />
    </joint>

    <link name = "wheel4_link">
        <visual>
            <origin rpy = "1.570795 0 0" xyz = "0 0 0" />
            <geometry>
                <cylinder length = "${d}" radius = "${r}" />
            </geometry>
            <material name = "pink" />
        </visual>

        <collision name = "wheel4_collision">
            <origin rpy = "1.57095 0 0" xyz = "0 0 0" />
            <geometry>
                <cylinder length = "${d}" radius = "${r}" />
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>2.0</mu>
                        <mu2>0.5</mu2>
                        <fdir1>1 1 0</fdir1>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>1000000.0</kp>
                        <kd>100.0</kd>
                        <min_depth>0.001</min_depth>
                        <max_vel>0.1</max_vel>
                    </ode>
                </contact>
            </surface>
        </collision>

        <xacro:inertia_wheel />
    </link>

</robot>