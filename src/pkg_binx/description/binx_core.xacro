<?xml version='1.0'?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <!-- STEP 5 - Gazebo plugin -->
  <xacro:include filename = "$(find pkg_binx)/description/robot.gazebo" />


    <!-- colors -->
    <material name="white">
        <color rgba="1 1 1 1" />
    </material>

    <material name="blue"> 
        <color rgba="0.150 0.178 0.242 1"/>
    </material>

    <material name="pink">
        <color rgba="0.237 0.199 0.220 1"/>
    </material>

    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

    <material name = "gray">
        <color rgba = "0.05 0.05 0.05 1"/>
    </material>

    <!-- ######################## -->
    <!-- Defining robot constants -->
    <!-- ######################## -->

    <xacro:property name = "pi_const" value = "3.14159265" />

    <!-- modifier -->
    <xacro:property name = "m" value = "2.0" />

    <!-- chassis dimensions -->
    <xacro:property name = "l" value = "${m*0.5}" />
    <xacro:property name = "h" value = "${m*0.15}" />
    <xacro:property name = "w" value = "${m*0.35}" />

    <!-- wheel radius and diameter -->
    <xacro:property name = "r" value = "${m*0.15}" />
    <xacro:property name = "d" value = "${m*0.1}" />

    <!-- other dimensions (look at aleks's vid for the full picture)-->
    <xacro:property name = "s1" value = "${h/2 + r}" />
    <xacro:property name = "s2" value = "${2*r}" />
    <xacro:property name = "s3" value = "${2*r}" />
    <xacro:property name = "s4" value = "${w/2 + d/2}" />
    <xacro:property name = "s5" value = "${0.002*d}"/>



<!-- _______________________________________________________________________________________________ -->
<!-- _______________________________________________________________________________________________ -->


  <!-- STEP 1 - Robot footprint -->
  <link name="base_footprint"></link>

  <!-- STEP 2 - Robot chassis = base_link -->
  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_footprint"/>
    <child link="base_link" />
  </joint>

  <link name='base_link'>
    <pose>0 0 0.1 0 0 0</pose>

    <inertial>
      <mass value="15.0"/>
      <origin xyz="0.0 0 0" rpy=" 0 0 0"/>
      <inertia
          ixx="0.0625" ixy="0" ixz="0"
          iyy="0.2125" iyz="0"
          izz="0.25"
      />
    </inertial>

    <collision>
      <origin xyz="0 0 ${h/2 + d/2}" rpy=" 0 0 0"/> 
      <geometry>
        <box size="${l} ${w} ${h}"/>
      </geometry>
    </collision>

    <visual name='base_link_visual'>
      <origin xyz="0 0 ${h/2 + d/2}" rpy=" 0 0 0"/>
      <geometry>
        <box size="${l} ${w} ${h}"/>
      </geometry>
      <material name="blue"/>
    </visual>

  </link>

<!-- _______________________________________________________________________________________________ -->






<!-- _______________________________________________________________________________________________ -->


  <!-- STEP 3 - Wheels -->
  <joint type="continuous" name="front_left_wheel_joint">
    <origin xyz="${r} ${s4} ${r/2}" rpy="-1.5707 0 0"/>
    <child link="front_left_wheel"/>
    <parent link="base_link"/>
    <axis xyz="0 0 1" rpy="0 0 0"/>
    <limit effort="10000" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name='front_left_wheel'>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
          ixx="0.145833" ixy="0" ixz="0"
          iyy="0.145833" iyz="0"
          izz="0.125"
      />
    </inertial>

    <collision>
      <geometry>
        <sphere radius="${d}"/>
      </geometry>
    </collision>

    <visual name='front_left_wheel_visual'>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
<!--         <sphere radius="${d}"/> -->
        <mesh filename="$(find pkg_binx)/models/mecanum_wheels/mecanum_wheel_left.STL" scale="0.0035 .0035 0.0035"/>
      </geometry>
      <material name="pink"/>
    </visual>
  </link>


<!-- _______________________________________________________________________________________________ -->


  <joint type="continuous" name="rear_left_wheel_joint">
    <origin xyz="${-r} ${s4} ${r/2}" rpy="-1.5707 0 0"/>
    <child link="rear_left_wheel"/>
    <parent link="base_link"/>
    <axis xyz="0 0 1" rpy="0 0 0"/>
    <limit effort="10000" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name='rear_left_wheel'>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
          ixx="0.145833" ixy="0" ixz="0"
          iyy="0.145833" iyz="0"
          izz="0.125"
      />
    </inertial>

    <collision>
      <geometry>
        <sphere radius="${d}"/>
      </geometry>
    </collision>

    <visual name='rear_left_wheel_visual'>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
<!--         <sphere radius="${d}"/> -->
        <mesh filename="$(find pkg_binx)/models/mecanum_wheels/mecanum_wheel_right.STL" scale="0.0035 .0035 0.0035"/>
      </geometry>
      <material name="pink"/>
    </visual>
  </link>

<!-- _______________________________________________________________________________________________ -->


  <joint type="continuous" name="front_right_wheel_joint">
    <origin xyz="${r} ${-s4} ${r/2}" rpy="-1.5707 0 0"/>
    <child link="front_right_wheel"/>
    <parent link="base_link"/>
    <axis xyz="0 0 1" rpy="0 0 0"/>
    <limit effort="10000" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name='front_right_wheel'>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
          ixx="0.145833" ixy="0" ixz="0"
          iyy="0.145833" iyz="0"
          izz="0.125"
      />
    </inertial>

    <collision>
      <geometry>
        <sphere radius="${d}"/>
      </geometry>
    </collision>

    <visual name='front_right_wheel_visual'>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
<!--         <sphere radius="${d}"/> -->
        <mesh filename="$(find pkg_binx)/models/mecanum_wheels/mecanum_wheel_right.STL" scale="0.0035 .0035 0.0035"/>
      </geometry>
      <material name="pink"/>
    </visual>
  </link>

<!-- _______________________________________________________________________________________________ -->


  <joint type="continuous" name="rear_right_wheel_joint">
    <origin xyz="${-r} ${-s4} ${r/2}" rpy="-1.5707 0 0"/>
    <child link="rear_right_wheel"/>
    <parent link="base_link"/>
    <axis xyz="0 0 1" rpy="0 0 0"/>
    <limit effort="10000" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name='rear_right_wheel'>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
          ixx="0.145833" ixy="0" ixz="0"
          iyy="0.145833" iyz="0"
          izz="0.125"
      />
    </inertial>

    <collision>
      <geometry>
        <sphere radius="${d}"/>
      </geometry>
    </collision>

    <visual name='rear_right_wheel_visual'>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
       <!--  <sphere radius="${d}"/> -->
        <mesh filename="$(find pkg_binx)/models/mecanum_wheels/mecanum_wheel_left.STL" scale="0.0035 .0035 0.0035"/>
      </geometry>
      <material name="pink"/>
    </visual>
  </link>


<!-- _______________________________________________________________________________________________ -->
<!-- _______________________________________________________________________________________________ -->






  <!-- STEP 6 - Gazebo frictions and colors -->
  <gazebo reference='front_left_wheel'>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_footprint">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference='rear_left_wheel'>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_footprint">1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference='front_right_wheel'>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_footprint">1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference='rear_right_wheel'>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_footprint">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="base_link">
    <mu1>0.000002</mu1>
    <mu2>0.000002</mu2>
    <!-- <material>Gazebo/Red</material> -->
  </gazebo>

</robot>