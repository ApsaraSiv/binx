<?xml version="1.0"?>
<sdf version="1.10">
  <world name="slam_test_world">

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0.0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <plugin filename="gz-sim-physics-system"          name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"    name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"          name="gz::sim::systems::Contact"/>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== OUTER WALLS ===================== -->
    <!-- Room:(12m wide), (10m deep) -->

    <model name="wall_north">
      <static>true</static>
      <pose>5.5 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>15.4 0.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>15.4 0.2 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>5.5 -5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>15.4 0.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>15.4 0.2 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>13 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.0 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-2 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.0 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== ZONE 1: OBSTACLE COURSE ===================== -->
    <!-- Robot spawns at (0,0) and navigates through these to reach the trash -->

    <!-- Obstacle A -->
    <model name="obs_a">
      <static>true</static>
      <pose>0.6 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle B -->
    <model name="obs_b">
      <static>true</static>
      <pose>0.6 -2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle D -->
    <model name="obs_d">
      <static>true</static>
      <pose>1.8 -2.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.4 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.8</size></box></geometry>
          <material><ambient>0.65 0.35 0.15 1</ambient><diffuse>0.65 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle E -->
    <model name="obs_e">
      <static>true</static>
      <pose>1.2 1.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.8</size></box></geometry>
          <material><ambient>0.65 0.35 0.15 1</ambient><diffuse>0.65 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle G -->
    <model name="obs_g">
      <static>true</static>
      <pose>6.5 3.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
          <material><ambient>0.65 0.35 0.15 1</ambient><diffuse>0.65 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle H -->
    <model name="obs_h">
      <static>true</static>
      <pose>10.0 -1.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.4 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.8</size></box></geometry>
          <material><ambient>0.65 0.35 0.15 1</ambient><diffuse>0.65 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

<!-- ===================== ZONE 2: MAZE ===================== -->
    <!--Three walls creating a zigzag corridor.-->

    <!-- Maze wall 1 orange -->
    <model name="maze_1">
      <static>true</static>
      <pose>3.5 -1.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3.5 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 3.5 1.5</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Maze wall 2 teal -->
    <model name="maze_2">
      <static>true</static>
      <pose>5.5 1.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3.5 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 3.5 1.5</size></box></geometry>
          <material><ambient>0.1 0.7 0.7 1</ambient><diffuse>0.1 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Maze wall 3 purple -->
    <!-- same layout as wall 1 -->
    <model name="maze_3">
      <static>true</static>
      <pose>7.5 -1.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3.5 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 3.5 1.5</size></box></geometry>
          <material><ambient>0.6 0.2 0.8 1</ambient><diffuse>0.6 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== BIN LINE ===================== -->
    <!-- All 3 bins at x=9.0 -->

    <!-- Red bin south -->
    <model name="bin_red">
      <static>true</static>
      <pose>12.0 -3.0 0.6 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.5 0.5 1.2</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Blue bin centre -->
    <model name="bin_blue">
      <static>true</static>
      <pose>12.0 0.0 0.6 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.5 0.5 1.2</size></box></geometry>
          <material><ambient>0.1 0.1 0.9 1</ambient><diffuse>0.1 0.1 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Green bin north -->
    <model name="bin_green">
      <static>true</static>
      <pose>12.0 3.0 0.6 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.5 0.5 1.2</size></box></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.1 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
